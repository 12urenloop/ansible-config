[Unit]
Description=Gonny Collector, collects detections into a database
Requires=network.target
Requires=time-sync.target
After=network.target
After=ntpd.service

[Service]
Type=simple
Restart=always
User=root
ExecStart=/gonny/cmds/collector/main
Environment="LOG_LEVEL=warning"
Environment="DATABASE_USER={{ ronny_db_user }}"
Environment="DATABASE_PASSWORD={{ ronny_db_password }}"
Environment="DATABASE_DB={{ ronny_db }}"

[Install]
WantedBy=multi-user.target
